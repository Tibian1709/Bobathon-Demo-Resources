{
  "api_version": "v2.1",
  "service": "Ingram Micro Cloud Marketplace Catalog Sync",
  "base_path": "/api/v2/catalog",
  "target_endpoints": [
    {
      "method": "POST",
      "path": "/products/batch-sync",
      "summary": "Synchronize third-party vendor product catalog items with Ingram Micro Cloud Marketplace",
      "authentication": "Bearer JWT with scope 'catalog:write'",
      "request_payload": {
        "vendor_id": "string (e.g. VEND-MICROSOFT-01)",
        "batch_id": "uuid string",
        "timestamp": "ISO8601 UTC timestamp",
        "products": [
          {
            "sku": "string (alphanumeric with dashes, 5-30 chars)",
            "product_name": "string (1-100 chars)",
            "category": "enum ['SAAS_SEAT', 'IaaS_CONSUMPTION', 'HARDWARE', 'PROFESSIONAL_SERVICES']",
            "msrp": "number (positive float, max 2 decimals)",
            "currency": "enum ['USD', 'EUR', 'CAD', 'GBP', 'AUD']",
            "billing_frequency": "enum ['MONTHLY', 'ANNUAL', 'ONE_TIME', 'USAGE_BASED']",
            "is_active": "boolean",
            "minimum_seats": "integer (>= 1)",
            "metadata": {
              "vendor_tier": "string",
              "support_tier": "string"
            }
          }
        ]
      },
      "response_payload": {
        "batch_id": "uuid string",
        "total_processed": "integer",
        "success_count": "integer",
        "error_count": "integer",
        "status": "enum ['COMPLETED', 'PARTIAL_SUCCESS', 'FAILED']",
        "errors": [
          {
            "sku": "string",
            "error_code": "string",
            "message": "string"
          }
        ],
        "processed_at": "ISO8601 UTC timestamp"
      }
    }
  ]
}
